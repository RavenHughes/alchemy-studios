<IfModule mod_rewrite.c>
RewriteEngine On
# Not a WordPress site: refuse WordPress login, xmlrpc and admin probes instantly (bots)
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin|wp-includes|wp-content|wp-json|wp-config\.php|wp-cron\.php|wp-signup\.php|wp-trackback\.php)(/|$) - [F,L]
</IfModule>

# Pages: always check for a new version, so updates show up right away.
# Everything else (images, fonts, styles, scripts, video): cached for a week,
# so a returning visitor's browser asks the server for almost nothing.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|gif|svg|ico|woff2|woff|css|js|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
DirectoryIndex index.html
